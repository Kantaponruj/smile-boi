# smileChatBot — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงก่อน start server
# ❌ ห้าม commit .env ลง git เด็ดขาด

# ─── LINE ───────────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ─── Authentication ──────────────────────────────────────────────────
# ใช้ค่า random string ยาวอย่างน้อย 64 chars
# generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_minimum_64_chars_here
JWT_EXPIRY=8h

# ─── Claude AI ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# claude-sonnet-4-20250514 — ใช้ค่านี้เสมอ
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1000

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/smilechatbot
# สำหรับ production เพิ่ม ?sslmode=require ต่อท้าย

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_KEY=smilechatbot:queue:pending
REDIS_QUEUE_TTL_SECONDS=300
REDIS_QUEUE_ALERT_THRESHOLD=100

# ─── Vector DB ───────────────────────────────────────────────────────
# เลือก provider ที่ใช้ (pgvector / chroma / pinecone)
VECTOR_DB_PROVIDER=pgvector

# pgvector (ใช้ DATABASE_URL เดิม)
VECTOR_DB_URL=${DATABASE_URL}

# Chroma
# VECTOR_DB_URL=http://localhost:8000
# VECTOR_DB_API_KEY=

# Pinecone
# VECTOR_DB_URL=https://your-index.svc.pinecone.io
# VECTOR_DB_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=smilechatbot-rulebook

# ─── Confidence Engine ───────────────────────────────────────────────
# ค่า default ตาม spec — ปรับหลัง Pilot ถ้าจำเป็น
CONFIDENCE_THRESHOLD=0.6
CONFIDENCE_HIGH_THRESHOLD=0.8
CONFIDENCE_WEIGHT_VECTOR=0.5
CONFIDENCE_WEIGHT_LLM=0.5

# ─── Application ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── PDPA / Data Retention ───────────────────────────────────────────
# จำนวนวันเก็บ chat logs ก่อนลบ
CHAT_LOG_RETENTION_DAYS=90
TAGGING_LOG_RETENTION_DAYS=365

# ─── Monitoring ──────────────────────────────────────────────────────
# Webhook URL สำหรับ alert (Slack incoming webhook หรือ custom)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
ALERT_CHANNEL=#ai-alerts
