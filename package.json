{
  "name": "smilechatbot",
  "version": "1.0.0",
  "description": "Evidence-Gated, Automated Journey Tagging Engine — LINE OA AI Tagging System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "db:seed": "node scripts/seed-db.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "next": "^14.2.5",
    "pino": "^9.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.2",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.41",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/boi_x_smile_SDD/",
      "/.next/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
